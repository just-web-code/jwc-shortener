namespace routes.ops;

import app;
import db.links;
import middleware.metrics;

/// `/healthz`, `/readyz` and `/metrics` are served by the runtime at fixed
/// names and are not declarable (config.md §4). 0.9.x needed `/healthz` and
/// `/readyz` written out here; 1.0 does not, and the built-in `/readyz`
/// round-trips Postgres *and* Redis and names which one failed, which the
/// hand-written one did not.
///
/// They survive `/{code}` because a route reaching one of those names only
/// through a path parameter does not win (§4.0.3). Before that rule this
/// service's catch-all answered the readiness probe with "no such link".
/// Aggregate traffic, for the counters on the landing page.
routes "/api/v1/stats" use MetricsTracker {
    route GET "" {
        let calls = select A from App.public.ApiCalls
            as {
                total: count(A.id)
            }
            first;

        let links = select L from App.public.Links
            as {
                total: count(L.code),
                clicks: sum(L.hits),
                top: max(L.hits)
            }
            first;

        /// The five most-followed links, which the 0.9 payload carried and
        /// the landing page still reads. `index on (hits)` is what keeps
        /// this from sorting the whole table on every call.
        let top = select L from App.public.Links
            where L.hits > 0
            as { L.code, L.hits }
            orderby L.hits desc
            limit 5;

        let day = select A from App.public.ApiCalls
            where A.ts > date.now() - date.hours(24)
            as {
                total: count(A.id)
            }
            first;

        // `total_clicks` below: `sum` answers `numeric`, which is carried
        // as a JSON string so no float ever touches money (types.md
        // §2.1). A click counter is not money and the landing page reads
        // it as a number, so it is narrowed back with `int(...)`. The
        // `?? "0"` is not decoration: `sum` over no rows is null, and
        // without it an empty `link` table answers
        // `400 {"error":"`` is not a number"}` — measured, on the endpoint
        // the landing page calls on every page load.
        //
        // It sits here rather than beside the field because `jwc fmt`
        // keeps a comment on a statement and a record literal is not one
        // (cli/formatting.md).
        return json({
            total: @calls.total,
            last_24h: @day.total,
            total_links: @links.total,
            total_clicks: int(@links.clicks ?? "0"),
            top_link_hits: @links.top,
            top_endpoints: @top,
            written_in: "JWC",
            source: "https://github.com/just-web-code/jwc-shortener"
        });
    }
}
