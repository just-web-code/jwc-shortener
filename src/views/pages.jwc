namespace views.pages;

--- Landing page, Swagger UI, OpenAPI document, and the crawler files.
--- Kept apart from the routes so `routes/pages.jwc` stays readable; the
--- routes reach them through `import views.pages`.
---
--- Every page is one string built from its own lines. v1 has no multi-line
--- string literal — `"..."` may not contain a newline and `r"..."` is for
--- regular expressions and ends at the line (names.md §2.3, §2.4) — so the
--- `\n` is explicit and the concatenation is the page.
---
--- HTML attributes stay single-quoted. Nothing forces that any more now
--- that these are ordinary escaped strings, but rewriting 360 lines to
--- change quote style would bury the port in noise, and single quotes are
--- valid HTML.

function landing_html() -> text {
    return "<!DOCTYPE html>\n"
        + "<html lang='en'>\n"
        + "<head>\n"
        + "<meta charset='utf-8'>\n"
        + "<meta name='viewport' content='width=device-width, initial-scale=1'>\n"
        + "<title>1kb.uz — Free URL Shortener &amp; the JWC Programming Language</title>\n"
        + "<meta name='description' content='1kb.uz is a fast, free URL shortener with instant QR codes, built entirely in the JWC programming language and its native HTTP server.'>\n"
        + "<link rel='canonical' href='https://1kb.uz/'>\n"
        + "<meta name='robots' content='index, follow'>\n"
        + "<meta name='theme-color' content='#0b0d10'>\n"
        + "<link rel='icon' type='image/svg+xml' href='data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2032%2032%22%3E%3Crect%20width=%2232%22%20height=%2232%22%20rx=%227%22%20fill=%22%230b0d10%22/%3E%3Ccircle%20cx=%2216%22%20cy=%2216%22%20r=%226%22%20fill=%22%236ee7b7%22/%3E%3C/svg%3E'>\n"
        + "<meta property='og:type' content='website'>\n"
        + "<meta property='og:site_name' content='1kb.uz'>\n"
        + "<meta property='og:title' content='1kb.uz — Free URL Shortener and the JWC Programming Language'>\n"
        + "<meta property='og:description' content='A fast, free URL shortener with instant QR codes, built entirely in the JWC programming language.'>\n"
        + "<meta property='og:url' content='https://1kb.uz/'>\n"
        + "<meta property='og:image' content='https://1kb.uz/og.svg'>\n"
        + "<meta property='og:image:type' content='image/svg+xml'>\n"
        + "<meta property='og:image:width' content='1200'>\n"
        + "<meta property='og:image:height' content='630'>\n"
        + "<meta property='og:image:alt' content='1kb.uz — URL shortener built in the JWC language'>\n"
        + "<meta name='twitter:card' content='summary_large_image'>\n"
        + "<meta name='twitter:title' content='1kb.uz — Free URL Shortener and the JWC Programming Language'>\n"
        + "<meta name='twitter:description' content='A fast, free URL shortener with instant QR codes, built entirely in the JWC programming language.'>\n"
        + "<meta name='twitter:image' content='https://1kb.uz/og.svg'>\n"
        + "<style>\n"
        + ":root { --bg:#0b0d10; --panel:#14181d; --panel-2:#1b2027; --text:#e6e8eb; --muted:#8a9099; --accent:#6ee7b7; --border:#232830; }\n"
        + "* { box-sizing: border-box; }\n"
        + "html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text); }\n"
        + "body { font: 15px/1.55 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; max-width: 920px; margin: 0 auto; padding: 48px 24px 64px; }\n"
        + "h1 { font-size: 40px; letter-spacing: -0.02em; margin: 0 0 4px; }\n"
        + "h1 .dot { color: var(--accent); }\n"
        + ".lede { color: var(--muted); font-size: 17px; margin: 0 0 32px; }\n"
        + ".links { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 32px; }\n"
        + ".links a { color: var(--text); text-decoration: none; padding: 8px 14px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; transition: background .15s, border-color .15s; }\n"
        + ".links a:hover { background: var(--panel-2); border-color: var(--accent); }\n"
        + ".shortener { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 20px; margin-bottom: 32px; }\n"
        + ".shortener label { display: block; color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }\n"
        + ".shortener .row { display: flex; gap: 8px; }\n"
        + ".shortener input { flex: 1; background: var(--panel-2); border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; color: var(--text); font: inherit; }\n"
        + ".shortener input:focus { outline: none; border-color: var(--accent); }\n"
        + ".shortener button { background: var(--accent); color: var(--bg); border: 0; border-radius: 6px; padding: 10px 18px; font-weight: 600; cursor: pointer; }\n"
        + ".shortener button:hover { opacity: 0.9; }\n"
        + ".shortener .result { margin-top: 12px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; color: var(--accent); word-break: break-all; }\n"
        + ".shortener .result.error { color: #f87171; }\n"
        + ".shortener .qr-wrap { margin-top: 14px; padding: 10px; border: 1px dashed var(--border); border-radius: 8px; display: inline-block; background: #fff; }\n"
        + ".shortener .qr-wrap img { display: block; width: 160px; height: 160px; }\n"
        + ".section-title { font-size: 12px; font-weight: 400; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 28px 0 12px; }\n"
        + ".cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }\n"
        + ".card { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; }\n"
        + ".card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; }\n"
        + ".card .value { color: var(--text); font-size: 22px; font-weight: 600; margin-top: 4px; font-variant-numeric: tabular-nums; }\n"
        + ".top-list { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 4px 0; margin-top: 10px; }\n"
        + ".top-row { display: flex; justify-content: space-between; padding: 10px 16px; border-top: 1px solid var(--border); font-size: 14px; }\n"
        + ".top-row:first-child { border-top: none; }\n"
        + ".top-row .path { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--text); }\n"
        + ".top-row .hits { color: var(--accent); font-variant-numeric: tabular-nums; }\n"
        + "/* WOW stats */\n"
        + ".hero-stats {display: grid;grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));gap: 14px;margin: 0 0 36px;}\n"
        + "\n"
        + ".hero-card {\n"
        + "  position: relative;\n"
        + "  overflow: hidden;\n"
        + "  background: linear-gradient(180deg, #161b22 0%, #12161c 100%);\n"
        + "  border: 1px solid var(--border);\n"
        + "  border-radius: 14px;\n"
        + "  padding: 18px;\n"
        + "}\n"
        + "\n"
        + ".hero-card::before {\n"
        + "  content: '';\n"
        + "  position: absolute;\n"
        + "  inset: 0;\n"
        + "  background:\n"
        + "    radial-gradient(circle at top right, rgba(110,231,183,.12), transparent 45%);\n"
        + "  pointer-events: none;\n"
        + "}\n"
        + "\n"
        + ".hero-kicker {\n"
        + "  color: var(--muted);\n"
        + "  text-transform: uppercase;\n"
        + "  letter-spacing: .08em;\n"
        + "  font-size: 11px;\n"
        + "  margin-bottom: 8px;\n"
        + "}\n"
        + "\n"
        + ".hero-value {\n"
        + "  font-size: 34px;\n"
        + "  line-height: 1;\n"
        + "  font-weight: 800;\n"
        + "  letter-spacing: -0.04em;\n"
        + "  color: var(--accent);\n"
        + "  font-variant-numeric: tabular-nums;\n"
        + "}\n"
        + "\n"
        + ".hero-sub {\n"
        + "  margin-top: 8px;\n"
        + "  color: var(--muted);\n"
        + "  font-size: 13px;\n"
        + "}\n"
        + "\n"
        + ".bench {\n"
        + "  margin: 34px 0;\n"
        + "  background: linear-gradient(180deg, #14181d 0%, #101419 100%);\n"
        + "  border: 1px solid var(--border);\n"
        + "  border-radius: 14px;\n"
        + "  padding: 22px;\n"
        + "}\n"
        + "\n"
        + ".bench-head {\n"
        + "  display: flex;\n"
        + "  justify-content: space-between;\n"
        + "  gap: 20px;\n"
        + "  align-items: flex-start;\n"
        + "  margin-bottom: 18px;\n"
        + "}\n"
        + "\n"
        + ".bench-title {\n"
        + "  font-size: 22px;\n"
        + "  font-weight: 700;\n"
        + "  letter-spacing: -0.03em;\n"
        + "}\n"
        + "\n"
        + ".bench-title span {\n"
        + "  color: var(--accent);\n"
        + "}\n"
        + "\n"
        + ".bench-copy {\n"
        + "  color: var(--muted);\n"
        + "  max-width: 520px;\n"
        + "  font-size: 14px;\n"
        + "}\n"
        + "\n"
        + ".bench-grid {\n"
        + "  display: grid;\n"
        + "  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n"
        + "  gap: 12px;\n"
        + "}\n"
        + "\n"
        + ".bench-box {\n"
        + "  background: rgba(255,255,255,.02);\n"
        + "  border: 1px solid var(--border);\n"
        + "  border-radius: 10px;\n"
        + "  padding: 14px;\n"
        + "}\n"
        + "\n"
        + ".bench-box .k {\n"
        + "  color: var(--muted);\n"
        + "  font-size: 11px;\n"
        + "  text-transform: uppercase;\n"
        + "  letter-spacing: .06em;\n"
        + "}\n"
        + "\n"
        + ".bench-box .v {\n"
        + "  margin-top: 6px;\n"
        + "  font-size: 28px;\n"
        + "  font-weight: 800;\n"
        + "  color: var(--text);\n"
        + "  font-variant-numeric: tabular-nums;\n"
        + "}\n"
        + "\n"
        + ".bench-box .d {\n"
        + "  margin-top: 4px;\n"
        + "  color: var(--muted);\n"
        + "  font-size: 12px;\n"
        + "}\n"
        + "\n"
        + ".highlight {\n"
        + "  color: var(--accent);\n"
        + "  font-weight: 700;\n"
        + "}\n"
        + "footer { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border); color: var(--muted); font-size: 13px; }\n"
        + "footer a { color: var(--accent); text-decoration: none; }\n"
        + "footer a:hover { text-decoration: underline; }\n"
        + "code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; background: var(--panel-2); padding: 1px 6px; border-radius: 4px; font-size: 13px; }\n"
        + "</style>\n"
        + json_ld()
        + "\n"
        + "</head>\n"
        + "<body>\n"
        + "<header>\n"
        + "<h1>1kb<span class='dot'>.uz</span></h1>\n"
        + "<p class='lede'>A URL shortener served by a JWC program. Same one-file source builds the API and this page.</p>\n"
        + "</header>\n"
        + "<main>\n"
        + "<div class='hero-stats'>\n"
        + "  <div class='hero-card'>\n"
        + "    <div class='hero-kicker'>Throughput</div>\n"
        + "    <div class='hero-value'>103k</div>\n"
        + "    <div class='hero-sub'>requests / second under load</div>\n"
        + "  </div>\n"
        + "\n"
        + "  <div class='hero-card'>\n"
        + "    <div class='hero-kicker'>Average latency</div>\n"
        + "    <div class='hero-value'>0.5ms</div>\n"
        + "    <div class='hero-sub'>across 6.2M+ requests</div>\n"
        + "  </div>\n"
        + "\n"
        + "  <div class='hero-card'>\n"
        + "    <div class='hero-kicker'>Reliability</div>\n"
        + "    <div class='hero-value'>100%</div>\n"
        + "    <div class='hero-sub'>successful responses</div>\n"
        + "  </div>\n"
        + "\n"
        + "  <div class='hero-card'>\n"
        + "    <div class='hero-kicker'>Stack</div>\n"
        + "    <div class='hero-value'>JWC</div>\n"
        + "    <div class='hero-sub'>custom language + native HTTP server</div>\n"
        + "  </div>\n"
        + "</div>\n"
        + "\n"
        + "<section class='shortener' aria-label='Shorten a URL'>\n"
        + "  <label for='url'>Shorten a URL</label>\n"
        + "  <div class='row'>\n"
        + "    <input id='url' type='url' placeholder='https://example.com/very/long/path'>\n"
        + "    <button id='go'>Shorten</button>\n"
        + "  </div>\n"
        + "  <div id='out' class='result'></div>\n"
        + "  <div id='qr' class='qr-wrap' style='display:none'></div>\n"
        + "</section>\n"
        + "\n"
        + "<nav class='links' aria-label='Project links'>\n"
        + "  <a href='https://github.com/Nodirbek-Abdulaxadov/jwc-shortener'>Source code</a>\n"
        + "  <a href='https://jwc.1kb.uz'>JWC language</a>\n"
        + "  <a href='/docs'>API docs</a>\n"
        + "  <a href='/openapi.json'>OpenAPI</a>\n"
        + "</nav>\n"
        + "\n"
        + "<section class='bench' aria-label='Benchmark results'>\n"
        + "  <div class='bench-head'>\n"
        + "    <div>\n"
        + "      <div class='bench-title'>\n"
        + "        Benchmarked at <span>102,551 req/sec</span>\n"
        + "      </div>\n"
        + "      <div class='bench-copy'>\n"
        + "        Measured locally, not on the deployment: a native AOT build of this program\n"
        + "        (<code>jwc build --native</code>, jwc 0.9.4) driven by bombardier at 50 connections\n"
        + "        against PostgreSQL 17, averaged over two 30-second runs of <code>GET /</code>.\n"
        + "        Every request is logged to <code>api_call</code> through the buffered writer,\n"
        + "        with no rows dropped.\n"
        + "      </div>\n"
        + "    </div>\n"
        + "  </div>\n"
        + "\n"
        + "  <div class='bench-grid'>\n"
        + "    <div class='bench-box'>\n"
        + "      <div class='k'>GET /healthz</div>\n"
        + "      <div class='v'>0.4ms</div>\n"
        + "      <div class='d'>~130k req/sec</div>\n"
        + "    </div>\n"
        + "\n"
        + "    <div class='bench-box'>\n"
        + "      <div class='k'>POST /api/links</div>\n"
        + "      <div class='v'>3.8ms</div>\n"
        + "      <div class='d'>URL creation, 1 req/sec</div>\n"
        + "    </div>\n"
        + "\n"
        + "    <div class='bench-box'>\n"
        + "      <div class='k'>Redirect</div>\n"
        + "      <div class='v'>5.3ms</div>\n"
        + "      <div class='d'>302, 1 req/sec</div>\n"
        + "    </div>\n"
        + "\n"
        + "    <div class='bench-box'>\n"
        + "      <div class='k'>Error rate</div>\n"
        + "      <div class='v'>0.00%</div>\n"
        + "      <div class='d'>6.2M requests, 0 failures</div>\n"
        + "    </div>\n"
        + "  </div>\n"
        + "  <div class='bench-copy'>\n"
        + "    <code>POST /api/links</code> and the redirect are rate-limited to 60 requests\n"
        + "    per minute per IP, so those two are latency at 1 req/sec, not throughput.\n"
        + "  </div>\n"
        + "</section>\n"
        + "\n"
        + "<section aria-labelledby='live-stats-title'>\n"
        + "<h2 class='section-title' id='live-stats-title'>Live stats</h2>\n"
        + "<div id='stats' class='cards'>\n"
        + "  <div class='card'><div class='label'>Total requests</div><div class='value' id='m-total'>-</div></div>\n"
        + "  <div class='card'><div class='label'>Last 24h</div><div class='value' id='m-24h'>-</div></div>\n"
        + "  <div class='card'><div class='label'>Total links</div><div class='value' id='m-links'>-</div></div>\n"
        + "  <div class='card'><div class='label'>Total clicks</div><div class='value' id='m-clicks'>-</div></div>\n"
        + "  <div class='card'><div class='label'>Top link hits</div><div class='value' id='m-top-hits'>-</div></div>\n"
        + "</div>\n"
        + "</section>\n"
        + "\n"
        + "<section aria-labelledby='top-urls-title'>\n"
        + "<h2 class='section-title' id='top-urls-title'>Top short URLs</h2>\n"
        + "<div id='top' class='top-list'>\n"
        + "  <div class='top-row'><span class='path'>loading...</span><span class='hits'></span></div>\n"
        + "</div>\n"
        + "</section>\n"
        + "</main>\n"
        + "\n"
        + "<footer>\n"
        + "  Made with JWC &mdash; see <a href='https://github.com/Nodirbek-Abdulaxadov/jwc-lang'>github.com/Nodirbek-Abdulaxadov/jwc-lang</a>.\n"
        + "  Source: <a href='https://github.com/Nodirbek-Abdulaxadov/jwc-shortener'>github.com/Nodirbek-Abdulaxadov/jwc-shortener</a>.\n"
        + "</footer>\n"
        + "\n"
        + "<script>\n"
        + "(function () {\n"
        + "  function fmtNum(n) { if (n == null) return '-'; if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M'; if (n >= 1000) return (n / 1000).toFixed(1) + 'k'; return String(n); }\n"
        + "  function setText(id, v) { var el = document.getElementById(id); if (el) el.textContent = v; }\n"
        + "\n"
        + "  var input = document.getElementById('url');\n"
        + "  var btn   = document.getElementById('go');\n"
        + "  var out   = document.getElementById('out');\n"
        + "  var qr    = document.getElementById('qr');\n"
        + "  function shorten() {\n"
        + "    var url = input.value.trim();\n"
        + "    if (!url) { out.className = 'result error'; out.textContent = 'paste a URL first'; return; }\n"
        + "    out.className = 'result'; out.textContent = 'shortening...';\n"
        + "    qr.style.display = 'none';\n"
        + "    qr.innerHTML = '';\n"
        + "    fetch('/api/links', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: url }) })\n"
        + "      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })\n"
        + "      .then(function (res) {\n"
        + "        if (!res.ok) { out.className = 'result error'; out.textContent = (res.body && res.body.error) || 'failed'; return; }\n"
        + "        out.className = 'result'; out.textContent = res.body.short;\n"
        + "        if (res.body.qr_svg) {\n"
        + "          qr.innerHTML = res.body.qr_svg;\n"
        + "          qr.style.display = 'inline-block';\n"
        + "        }\n"
        + "        input.value = '';\n"
        + "      })\n"
        + "      .catch(function () { out.className = 'result error'; out.textContent = 'network error'; });\n"
        + "  }\n"
        + "  btn.addEventListener('click', shorten);\n"
        + "  input.addEventListener('keydown', function (e) { if (e.key === 'Enter') shorten(); });\n"
        + "\n"
        + "  fetch('/api/v1/stats', { headers: { 'accept': 'application/json' } })\n"
        + "    .then(function (r) { return r.json(); })\n"
        + "    .then(function (s) {\n"
        + "      setText('m-total', fmtNum(s.total));\n"
        + "      setText('m-24h',   fmtNum(s.last_24h));\n"
        + "      setText('m-links', fmtNum(s.total_links));\n"
        + "      setText('m-clicks', fmtNum(s.total_clicks));\n"
        + "      setText('m-top-hits', fmtNum(s.top_link_hits));\n"
        + "      var top = document.getElementById('top');\n"
        + "      top.innerHTML = '';\n"
        + "      var rows = (s.top_endpoints || []);\n"
        + "      if (typeof rows === 'string') {\n"
        + "        try { rows = JSON.parse(rows); } catch (_) { rows = []; }\n"
        + "      }\n"
        + "      if (rows.length === 0) {\n"
        + "        var empty = document.createElement('div'); empty.className = 'top-row';\n"
        + "        var ep = document.createElement('span'); ep.className = 'path'; ep.textContent = '(no traffic yet)';\n"
        + "        var eh = document.createElement('span'); eh.className = 'hits';\n"
        + "        empty.appendChild(ep); empty.appendChild(eh); top.appendChild(empty);\n"
        + "        return;\n"
        + "      }\n"
        + "      rows.forEach(function (row) {\n"
        + "        var div = document.createElement('div'); div.className = 'top-row';\n"
        + "        var p = document.createElement('span'); p.className = 'path'; p.textContent = window.location.host + '/' + row.code;\n"
        + "        var h = document.createElement('span'); h.className = 'hits'; h.textContent = fmtNum(row.hits);\n"
        + "        div.appendChild(p); div.appendChild(h);\n"
        + "        top.appendChild(div);\n"
        + "      });\n"
        + "    })\n"
        + "    .catch(function () { setText('m-total', '?'); });\n"
        + "})();\n"
        + "</script>\n"
        + "</body>\n"
        + "</html>";
}

function landing_docs() -> text {
    return "<!DOCTYPE html>\n"
        + "<html lang='en'>\n"
        + "<head>\n"
        + "<meta charset='utf-8'>\n"
        + "<meta name='viewport' content='width=device-width, initial-scale=1'>\n"
        + "<title>1kb.uz API Reference — Interactive Docs (Swagger UI)</title>\n"
        + "<meta name='description' content='Interactive OpenAPI reference for the 1kb.uz URL shortener API: create short links, resolve codes, and read live traffic stats.'>\n"
        + "<link rel='canonical' href='https://1kb.uz/docs'>\n"
        + "<meta name='theme-color' content='#0b0d10'>\n"
        + "<link rel='icon' type='image/svg+xml' href='data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2032%2032%22%3E%3Crect%20width=%2232%22%20height=%2232%22%20rx=%227%22%20fill=%22%230b0d10%22/%3E%3Ccircle%20cx=%2216%22%20cy=%2216%22%20r=%226%22%20fill=%22%236ee7b7%22/%3E%3C/svg%3E'>\n"
        + "<meta property='og:type' content='website'>\n"
        + "<meta property='og:site_name' content='1kb.uz'>\n"
        + "<meta property='og:title' content='1kb.uz API Reference'>\n"
        + "<meta property='og:description' content='Interactive OpenAPI reference for the 1kb.uz URL shortener API.'>\n"
        + "<meta property='og:url' content='https://1kb.uz/docs'>\n"
        + "<link rel='stylesheet' href='https://unpkg.com/swagger-ui-dist@5/swagger-ui.css'>\n"
        + "<style>body { margin: 0; }</style>\n"
        + "</head>\n"
        + "<body>\n"
        + "<div id='swagger-ui'></div>\n"
        + "<script src='https://unpkg.com/swagger-ui-dist@5/swagger-ui-bundle.js'></script>\n"
        + "<script>\n"
        + "window.onload = function () {\n"
        + "  window.ui = SwaggerUIBundle({\n"
        + "    url: '/openapi.json',\n"
        + "    dom_id: '#swagger-ui',\n"
        + "    deepLinking: true,\n"
        + "    presets: [SwaggerUIBundle.presets.apis],\n"
        + "    layout: 'BaseLayout'\n"
        + "  });\n"
        + "};\n"
        + "</script>\n"
        + "</body>\n"
        + "</html>";
}

function openapi_spec() -> text {
    -- JWC object literals only allow bare identifier keys (no "/") and no
    -- array literals — hand-write the OpenAPI as a string. Swagger UI
    -- validates it as JSON on page load.
    return "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"1kb.uz API\",\"version\":\"0.1.0\",\"description\":\"URL shortener + landing, served by a JWC program.\"},\"servers\":[{\"url\":\"https://1kb.uz\"}],\"paths\":{\"/\":{\"get\":{\"summary\":\"Landing page (HTML)\",\"responses\":{\"200\":{\"description\":\"HTML landing page\"}}}},\"/healthz\":{\"get\":{\"summary\":\"Liveness probe\",\"responses\":{\"200\":{\"description\":\"ok\"}}}},\"/api/links\":{\"post\":{\"summary\":\"Create a short link\",\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"url\"],\"properties\":{\"url\":{\"type\":\"string\",\"format\":\"uri\",\"minLength\":8,\"maxLength\":2048}}}}}},\"responses\":{\"201\":{\"description\":\"Created — returns short code + URL\"},\"400\":{\"description\":\"Validation failed\"}}}},\"/api/links/{code}\":{\"get\":{\"summary\":\"Look up a short link\",\"parameters\":[{\"name\":\"code\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"Link metadata\"},\"404\":{\"description\":\"No such link\"}}}},\"/{code}\":{\"get\":{\"summary\":\"Redirect to the original URL\",\"parameters\":[{\"name\":\"code\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"responses\":{\"302\":{\"description\":\"Redirect\"},\"404\":{\"description\":\"No such link\"}}}},\"/api/v1/stats\":{\"get\":{\"summary\":\"Aggregate traffic stats\",\"responses\":{\"200\":{\"description\":\"Stats payload\"},\"429\":{\"description\":\"Rate limited (60 req / 60s per IP)\"}}}},\"/openapi.json\":{\"get\":{\"summary\":\"This OpenAPI document\",\"responses\":{\"200\":{\"description\":\"OpenAPI 3.0 JSON\"}}}},\"/docs\":{\"get\":{\"summary\":\"Swagger UI\",\"responses\":{\"200\":{\"description\":\"Interactive API docs (HTML)\"}}}}}}";
}

-- JSON-LD (schema.org WebSite) for the landing page. Kept as a regular
-- (escaped) string — not a raw `r"..."` — because JSON-LD requires real
-- double quotes, which would otherwise terminate a raw string. Injected
-- into the landing `<head>` via string concatenation in `landing_html()`.
function json_ld() -> text {
    return "<script type='application/ld+json'>{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"1kb.uz\",\"alternateName\":\"1kb URL Shortener\",\"url\":\"https://1kb.uz/\",\"description\":\"Fast, free URL shortener with instant QR codes, built in the JWC programming language.\",\"inLanguage\":\"en\"}</script>";
}

-- robots.txt body. Allows crawling everything except the JSON API surface
-- (nothing indexable there) and advertises the sitemap. Served as plain
-- text by the `robots.txt` route.
function robots_txt() -> text {
    return "User-agent: *\n"
        + "Allow: /\n"
        + "Disallow: /api/\n"
        + "\n"
        + "Sitemap: https://1kb.uz/sitemap.xml\n";
}

-- XML sitemap. Only lists same-host, indexable pages — the landing page and
-- the API reference. XML permits single-quoted attribute values, so this
-- fits in a raw string without escaping (no double quotes to end it early).
function sitemap_xml() -> text {
    return "<?xml version='1.0' encoding='UTF-8'?>\n"
        + "<urlset xmlns='http://www.sitemaps.org/schemas/sitemap/0.9'>\n"
        + "  <url>\n"
        + "    <loc>https://1kb.uz/</loc>\n"
        + "    <changefreq>weekly</changefreq>\n"
        + "    <priority>1.0</priority>\n"
        + "  </url>\n"
        + "  <url>\n"
        + "    <loc>https://1kb.uz/docs</loc>\n"
        + "    <changefreq>monthly</changefreq>\n"
        + "    <priority>0.5</priority>\n"
        + "  </url>\n"
        + "</urlset>\n";
}

-- Social-share card (OpenGraph / Twitter `og:image`) generated as SVG so it
-- ships with the source instead of a committed binary. Single-quoted
-- attributes keep it valid inside a raw string. Note: some scrapers
-- (Facebook, LinkedIn, X) prefer a raster 1200x630 PNG — swap the og:image
-- URL for a static og.png if universal previews are needed.
function og_svg() -> text {
    return "<svg xmlns='http://www.w3.org/2000/svg' width='1200' height='630' viewBox='0 0 1200 630' role='img' aria-label='1kb.uz — URL shortener built in the JWC language'>\n"
        + "  <defs>\n"
        + "    <linearGradient id='bg' x1='0' y1='0' x2='0' y2='1'>\n"
        + "      <stop offset='0' stop-color='#161b22'/>\n"
        + "      <stop offset='1' stop-color='#0b0d10'/>\n"
        + "    </linearGradient>\n"
        + "    <radialGradient id='glow' cx='0.82' cy='0.12' r='0.7'>\n"
        + "      <stop offset='0' stop-color='#6ee7b7' stop-opacity='0.18'/>\n"
        + "      <stop offset='1' stop-color='#6ee7b7' stop-opacity='0'/>\n"
        + "    </radialGradient>\n"
        + "  </defs>\n"
        + "  <rect width='1200' height='630' fill='url(#bg)'/>\n"
        + "  <rect width='1200' height='630' fill='url(#glow)'/>\n"
        + "  <text x='96' y='300' font-family='ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif' font-size='132' font-weight='800' letter-spacing='-5' fill='#e6e8eb'>1kb<tspan fill='#6ee7b7'>.uz</tspan></text>\n"
        + "  <text x='100' y='372' font-family='ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif' font-size='40' fill='#8a9099'>Free URL shortener &#183; built in the JWC language</text>\n"
        + "  <text x='100' y='470' font-family='ui-monospace, SFMono-Regular, Menlo, monospace' font-size='30' fill='#6ee7b7'>103k req/s &#183; 0.5ms latency &#183; 0 failed requests</text>\n"
        + "</svg>\n";
}
