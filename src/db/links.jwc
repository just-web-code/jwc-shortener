namespace db.links;

--- One short link. `code` is the slug in the short URL and the primary
--- key: the redirect is a single lookup on it, which is the hot path.
table Links of App.public as "link" {
    code       varchar(8) primary key;
    url        varchar(2048);
    hits       int default 0;
    created_at timestamptz default now();
}

--- One logged request. Written from `MetricsTracker`'s `after` block, so
--- the row carries the status and the duration the client actually saw.
table ApiCalls of App.public as "api_call" {
    id         bigint primary key identity;
    path       varchar(200);
    method     varchar(8);
    status     int;
    --- Whole milliseconds, kept because a deploy can land either side of
    --- the migration that added the microsecond column. `GET /` answers in
    --- well under a millisecond, so across 1.48M logged requests this
    --- recorded min 0, max 1, mean 0.00 — measured, and useless for a
    --- percentile.
    latency_ms int;
    latency_us int;
    ts         timestamptz default now();

    index on (ts);
}
