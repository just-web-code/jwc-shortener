{
  "components": {
    "schemas": {
      "LinkCreate": {
        "properties": {
          "url": {
            "minLength": 8,
            "pattern": "^https?://",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "1kb.uz API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
