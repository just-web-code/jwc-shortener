          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "qr_svg": {
                      "type": "string"
                    },
                    "short": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "short",
                    "qr_svg"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Created"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "TooManyRequests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "CodeExhausted"
          }
        },
        "x-jwc-middleware": [
          "MetricsTracker",
          "RateLimit"
        ]
      }
    },
    "/api/links/{code}": {
      "get": {
        "operationId": "getApiLinksCode",
